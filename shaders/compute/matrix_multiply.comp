#version 430 core

/* C = A * B, compute shader ile. matrix_multiply.frag ile ayni algoritma.
 *
 * Farklar:
 *   - Veri dokuda degil SSBO'da: duz float dizisi, indisleme C tarafiyla ayni.
 *   - Is dagitimini rasterizer degil biz yapiyoruz: glDispatchCompute ile
 *     kac workgroup calisacagini, local_size ile her grupta kac invocation
 *     olacagini biz seciyoruz.
 *   - Cikti tek bir piksele bagli degil; C[] dizisinde istenen yere yazilabilir
 *     (scatter). Bu ornekte kullanmiyoruz ama fragment yolunun yapamadigi sey bu.
 *
 * 16x16 = 256 invocation'lik gruplar, yaygin ve guvenli bir varsayilan
 * (GL_MAX_COMPUTE_WORK_GROUP_INVOCATIONS en az 1024 olmak zorunda). */

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly  buffer BufA { float A[]; };
layout(std430, binding = 1) readonly  buffer BufB { float B[]; };
layout(std430, binding = 2) writeonly buffer BufC { float C[]; };

uniform int uM;   /* C'nin satir sayisi */
uniform int uN;   /* C'nin sutun sayisi */
uniform int uK;   /* toplama uzunlugu */

void main()
{
    int j = int(gl_GlobalInvocationID.x);
    int i = int(gl_GlobalInvocationID.y);

    /* N, 16'nin katı değilse son gruplarda tasan invocation'lar olusur.
     * Fragment yolunda bu sorun yok: viewport tam N x N, rasterizer fazla
     * fragment uretmez. Compute'ta siniri elle kontrol etmek gerekir. */
    if (i >= uM || j >= uN)
        return;

    float acc = 0.0;
    for (int k = 0; k < uK; ++k)
        acc += A[i * uK + k] * B[k * uN + j];

    C[i * uN + j] = acc;
}
